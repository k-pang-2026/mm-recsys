FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY requirements-dashboard.txt .
COPY docker/constraints-dashboard-py311-linux-arm64.txt /tmp/constraints.txt
RUN pip install --no-cache-dir -r requirements-dashboard.txt -c /tmp/constraints.txt && pip check
COPY dashboard ./dashboard
COPY docker/__init__.py docker/http.py docker/dashboard_entrypoint.py ./docker/
COPY config.yaml .env ./
CMD ["python", "-m", "docker.dashboard_entrypoint"]
